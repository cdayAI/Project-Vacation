# Project Vacation — configuration
#
# Copy to .env for local development. Every value here is a default that is
# either safe or absent; nothing in this file is a secret, and nothing in this
# file should ever become one. Real credentials come from the deployment's
# secret manager and are never committed.
#
# The loader (packages/platform/src/kernel/config.ts) fails closed: an invalid
# value stops startup rather than falling back to something permissive, and
# staging and production reject several of the development defaults outright.

# --- Environment -------------------------------------------------------------
# development | test | staging | production
PV_ENV=development
PV_SERVICE_NAME=project-vacation
PV_HTTP_PORT=8080
PV_LOG_LEVEL=info

# --- Operating record --------------------------------------------------------
# "memory" is not durable and is refused in staging and production.
# Use "postgres" plus PV_DATABASE_URL for anything you intend to keep.
PV_STORE=memory
# PV_DATABASE_URL=postgresql://vacation:vacation@localhost:5432/vacation
PV_DATABASE_POOL_SIZE=10

# --- Identity ----------------------------------------------------------------
# Required in staging and production. There is no local password store; when
# these are absent in development the platform uses the development identity
# provider, which refuses to run anywhere else.
# The provider is assumed to be Okta or Microsoft Entra — CONFIRM WITH MVW,
# along with whether SCIM provisioning is available.
# PV_OIDC_ISSUER=https://example.okta.com/oauth2/default
# PV_OIDC_CLIENT_ID=
# PV_OIDC_CLIENT_SECRET=
# PV_OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
# PV_SESSION_SECRET=   # at least 32 characters in staging and production
PV_STEP_UP_MAX_AGE_SECONDS=300

# --- Containment -------------------------------------------------------------
# disabled  | nothing executes. The default and the only mode that is safe
#           | without external help.
# subprocess| a child process with a timeout. Constrains accidents, NOT
#           | adversaries. Never run untrusted code in this mode.
# external  | delegates to the deployment's isolation service. The only mode
#           | appropriate for untrusted code. Refuses if none is wired in.
PV_SANDBOX_MODE=disabled
PV_SANDBOX_TIMEOUT_MS=10000

# Comma-separated hosts the platform may call. An empty allowlist refuses every
# outbound integration call, which is the intended default.
PV_EGRESS_ALLOWLIST=

# --- Work discovery ----------------------------------------------------------
# Employee observation. Ships disabled and must stay disabled until employee
# notice and consent, state electronic-monitoring notice law, works-council and
# GDPR obligations for non-US staff, and union constraints are answered in
# writing. See docs/adr/0012-work-discovery-default-off.md.
PV_DISCOVERY_ENABLED=false
PV_DISCOVERY_RETENTION_DAYS=7

# --- Ceilings ----------------------------------------------------------------
# Enforced at consumption, not only pre-flight.
PV_RUN_SPEND_CEILING_USD=5
PV_DAILY_SPEND_CEILING_USD=500
PV_RUN_WALL_CLOCK_CEILING_MS=900000
PV_MODEL_CALLS_PER_MINUTE=120

# --- Model providers ---------------------------------------------------------
# "fake" is a deterministic test double. It is refused in staging and
# production. Approved providers and models, where keys live, and whether zero
# data retention and no-training terms are contractually in place must be
# confirmed with MVW and recorded before any production use.
PV_MODEL_PROVIDER=fake
# PV_ANTHROPIC_API_KEY=
PV_ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Retention ---------------------------------------------------------------
# Audit retention default is seven years. The correct figure is a policy
# decision for MVW legal, not an engineering default.
PV_AUDIT_RETENTION_DAYS=2555

# --- Demo --------------------------------------------------------------------
# Seeds identifiers and the fake model provider so the demo reproduces exactly.
PV_DEMO_SEED=project-vacation-demo-v1

# --- Tests -------------------------------------------------------------------
# When set, the persistence contract tests run against a real Postgres in
# addition to the in-memory adapter. CI always sets this.
# PV_TEST_DATABASE_URL=postgresql://vacation:vacation@localhost:5432/vacation_test
